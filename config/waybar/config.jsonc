{
    "backlight": {
        "format": "{percent:0>2}%",
        "on-scroll-down": "exec swayosd-client --brightness=-1",
        "on-scroll-up": "exec swayosd-client --brightness=+1"
    },
    "battery": {
        "format": "{icon}{capacity:0>2}%",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰠈",
                "󰠉",
                "󰠊",
                "󰠋",
                "󰠌",
                "󰠍",
                "󰠎",
                "󰠏",
                "󰠐",
                "󰠇"
            ]
        },
        "format-plugged": "󱐥{capacity:0>2}%"
    },
    "bluetooth": {
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "on-click-middle": "exec kitty -e bluetui",
        "tooltip-format": "Status {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias:<20.15}{device_battery_percentage:>3}%"
    },
    "clock": {
        "actions": {
            "on-click-middle": "shift_reset",
            "on-scroll-down": "shift_up",
            "on-scroll-up": "shift_down"
        },
        "calendar": {
            "format": {
                "today": "<span color='#ffff00'><b>{}</b></span>"
            },
            "mode": "year",
            "mode-mon-col": 3
        },
        "format": "  {:%H:%M\n%Y-%m-%d}",
        "locale": "C",
        "tooltip-format": "{calendar}"
    },
    "ext/workspaces": {
        "on-click": "activate"
    },
    "hyprland/window": {
        "icon": true,
        "icon-size": 30
    },
    "mode": "dock",
    "modules-center": [
        "ext/workspaces",
        "wlr/taskbar"
    ],
    "modules-left": [
        "clock",
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "battery",
        "wireplumber",
        "backlight"
    ],
    "network": {
        "format-disabled": "",
        "format-disconnected": "󰈂",
        "format-ethernet": "{bandwidthUpBytes:>}\n{bandwidthDownBytes:>}",
        "format-icons": {
            "wifi": [
                "󰢿",
                "󰢼",
                "󰢽",
                "󰢾"
            ]
        },
        "format-linked": "",
        "format-wifi": "{bandwidthUpBytes:>}\n{bandwidthDownBytes:>}",
        "interval": 2,
        "on-click-middle": "exec kitty -e nmtui",
        "tooltip-format-disabled": "Disabled",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format-ethernet": "{linkSpeed}",
        "tooltip-format-wifi": "{essid} {icon} {frequency}GHz"
    },
    "tray": {
        "icon-size": 30
    },
    "wireplumber": {
        "format": "󰕾{volume:0>2}%",
        "format-muted": "󰖁{volume:0>2}%",
        "on-click-middle": "exec swayosd-client --output-volume=mute-toggle",
        "on-scroll-down": "exec swayosd-client --output-volume=-1",
        "on-scroll-up": "exec swayosd-client --output-volume=+1"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 30,
        "on-click": "activate",
        "on-click-right": "maximize",
        "tooltip-format": "{title}"
    }
}
