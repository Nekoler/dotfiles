#!/usr/bin/sh
ROOT="${HOME}/.local/app/pwvucontrol"
export GSETTINGS_SCHEMA_DIR="${ROOT}/usr/share/glib-2.0/schemas"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+${LD_LIBRARY_PATH}:}${ROOT}/usr/lib/x86_64-linux-gnu"
export PWVUCONTROL_LOCALEDIR="${ROOT}/usr/share/locale"
export PWVUCONTROL_RESOURCEDIR="${ROOT}/usr/share/pwvucontrol"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/share}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS}:${ROOT}/usr/share"
exec "${ROOT}/usr/bin/pwvucontrol" "$@"
