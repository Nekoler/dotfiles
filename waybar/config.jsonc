{
    "mode": "dock",
    "height": 108,
    "modules-left": [
        "hyprland/workspaces",
        "taskbar"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "network",
        "tray",
        "battery",
        "wireplumber",
        "backlight",
        "clock"
    ],
    "hyprland/workspaces": {
        "icon-size": 32,
        "spacing": 16,
    },
    "taskbar": {
        "format": "{icon}",
        "icon-size": 28,
        "spacing": 3,
        "tooltip-format": "{title}"
    },
    "network": {
        "format-wifi": "{bandwidthUpBytesCompact}/s{:%n}{bandwidthDownBytesCompact}/s",
        "format-disconnected": "󰈂",
        "on-click-middle": "exec wezterm start --cwd . -- nmtui",
        "on-click-right": "exec wezterm start --cwd . -- bluetui"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 3
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": "󰠠 {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "wireplumber": {
        "format": " {volume}%",
        "on-scroll-up": "exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
        "on-scroll-down": "exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"
    },
    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "exec brightnessctl set 1%+",
        "on-scroll-down": "exec brightnessctl set 1%-"
    },
    "clock": {
        "format": "{:%H:%M%n%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "first-day-of-week": 0,
            "format": {
                "today": "<u><b>{}</b></u>"
            }
        }
    }
}